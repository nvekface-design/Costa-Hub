-- ========================================================
-- 5. FUNÇÕES DO HUB
-- ========================================================
local function CreateToggle(name, callback)
    local toggleState = false
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -4, 0, 32)
    Button.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    Button.BackgroundTransparency = 0.2
    Button.Text = "    " .. name
    Button.TextColor3 = Color3.fromRGB(200, 200, 210)
    Button.TextSize = 11
    Button.Font = Enum.Font.GothamMedium
    Button.TextXAlignment = Enum.TextXAlignment.Left
    Button.AutoButtonColor = false
    Button.Parent = ContentMain

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Button

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Name = "DefaultStroke"
    BtnStroke.Color = Color3.fromRGB(35, 35, 48)
    BtnStroke.Thickness = 1
    BtnStroke.Transparency = 0.3
    BtnStroke.Parent = Button

    local SwitchBase = Instance.new("Frame")
    SwitchBase.Size = UDim2.new(0, 32, 0, 18)
    SwitchBase.Position = UDim2.new(1, -40, 0.5, -9)
    SwitchBase.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    SwitchBase.BorderSizePixel = 0
    SwitchBase.Parent = Button

    local BaseCorner = Instance.new("UICorner")
    BaseCorner.CornerRadius = UDim.new(1, 0)
    BaseCorner.Parent = SwitchBase

    local SwitchStroke = Instance.new("UIStroke")
    SwitchStroke.Color = Color3.fromRGB(45, 45, 60)
    SwitchStroke.Thickness = 1
    SwitchStroke.Parent = SwitchBase

    local SwitchBall = Instance.new("Frame")
    SwitchBall.Size = UDim2.new(0, 12, 0, 12)
    SwitchBall.Position = UDim2.new(0, 3, 0.5, -6)
    SwitchBall.BackgroundColor3 = Color3.fromRGB(200, 205, 220)
    SwitchBall.BorderSizePixel = 0
    SwitchBall.Parent = SwitchBase

    local BallCorner = Instance.new("UICorner")
    BallCorner.CornerRadius = UDim.new(1, 0)
    BallCorner.Parent = SwitchBall

    Button.MouseButton1Click:Connect(function()
        toggleState = not toggleState
        
        local targetBaseColor, targetBallColor, targetBallPos
        if toggleState then
            targetBaseColor = Color3.fromRGB(0, 140, 255)
            targetBallColor = Color3.fromRGB(255, 255, 255)
            targetBallPos = UDim2.new(1, -15, 0.5, -6)
        else
            targetBaseColor = Color3.fromRGB(28, 28, 38)
            targetBallColor = Color3.fromRGB(200, 205, 220)
            targetBallPos = UDim2.new(0, 3, 0.5, -6)
        end

        TweenService:Create(SwitchBase, TweenInfo.new(0.25), {BackgroundColor3 = targetBaseColor}):Play()
        TweenService:Create(SwitchBall, TweenInfo.new(0.25), {BackgroundColor3 = targetBallColor, Position = targetBallPos}):Play()

        callback(toggleState)
    end)
end

-- 1. Anti-Lag
CreateToggle("Anti-Lag", function(enabled)
    if enabled then
        task.defer(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            if Lighting:FindFirstChildOfClass("Sky") then
                Lighting:FindFirstChildOfClass("Sky"):Destroy()
            end
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v:Destroy()
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") then
                    v.Enabled = false
                end
            end
        end)
    end
end)

-- 2. Infinite Jump
local InfJumpEnabled = false
CreateToggle("Infinite Jump", function(enabled)
    InfJumpEnabled = enabled
end)

UserInputService.JumpRequest:Connect(function()
    if InfJumpEnabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if humanoid and rootPart then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                rootPart.AssemblyLinearVelocity = Vector3.new(
                    rootPart.AssemblyLinearVelocity.X, 
                    50, 
                    rootPart.AssemblyLinearVelocity.Z
                )
            end
        end
    end
end)

-- 3. Anti Ragdoll
local AntiRagdollEnabled = false
CreateToggle("Anti Ragdoll", function(enabled)
    AntiRagdollEnabled = enabled
end)

RunService.Heartbeat:Connect(function()
    if AntiRagdollEnabled and LocalPlayer.Character then
        local character = LocalPlayer.Character
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if humanoid then
            local currentState = humanoid:GetState()
            if currentState == Enum.HumanoidStateType.Ragdoll or 
               currentState == Enum.HumanoidStateType.FallingDown or 
               currentState == Enum.HumanoidStateType.PlatformStanding then
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                humanoid.PlatformStand = false
            end
        end

        for _, obj in pairs(character:GetDescendants()) do
            if obj:IsA("BallSocketConstraint") or obj:IsA("HingeConstraint") then
                obj.Enabled = false
            end
        end
    end
end)

-- 4. Anti Hit
local AntiHitEnabled = false
CreateToggle("Anti Hit", function(enabled)
    AntiHitEnabled = enabled
end)

RunService.Heartbeat:Connect(function()
    if AntiHitEnabled and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
            humanoid.Health = humanoid.MaxHealth
        end
    end
end)
