-- 1. TELA DE INJEÇÃO
-- ========================================================
local SplashText = Instance.new("TextLabel")
SplashText.Name = "SplashText"
SplashText.Size = UDim2.new(0, 500, 0, 80)
SplashText.Position = UDim2.new(0.5, -250, 0.4, -40)
SplashText.BackgroundTransparency = 1
SplashText.Text = "COSTA HUB"
SplashText.TextColor3 = Color3.fromRGB(255, 255, 255)
SplashText.TextSize = 40
SplashText.Font = Enum.Font.GothamBold
SplashText.Parent = Gui

SplashText.TextTransparency = 1
TweenService:Create(SplashText, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
task.wait(3.5)
TweenService:Create(SplashText, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
task.wait(0.3)
SplashText:Destroy()

